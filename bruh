local function toolInspectInstance(args)
    local path = args and args.path or ""

    local instance, errorMessage = resolvePath(path)
    if not instance then
        return {
            ok = false,
            error = errorMessage
        }
    end

    local children = {}

    for _, child in ipairs(instance:GetChildren()) do
        table.insert(children, {
            name = child.Name,
            className = child.ClassName,
            fullName = safeFullName(child)
        })
    end

    table.sort(children, function(a, b)
        return a.fullName < b.fullName
    end)

    return {
        ok = true,
        instance = describeInstance(instance),
        childCount = #children,
        children = children
    }
end

