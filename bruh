local friendlyTools, renderToolEvent, describeToolArgs, summarizeToolResult, packToolResult
do
friendlyTools = {
    thinking = "Thinking about the next action",
    inspect_workspace = "Scanning workspace",
    inspect_instance = "Inspecting instance",
    inspect_remotes = "Indexing remote instances",
    inspect_player = "Reading player state",
    get_place_info = "Reading place info",
    get_live_remotes = "Reading remote traffic",
    get_remote_summary = "Summarizing remote traffic",
    get_remote_activity = "Reading logged remote calls",
    get_remote_call = "Opening a remote call",
    remote_spy_control = "Managing remote spy",
    search_game = "Searching the whole game",
    get_console_logs = "Reading console logs",
    read_session_log = "Reading the session log",
    get_workspace_live = "Refreshing workspace snapshot",
    get_asset_status = "Checking runtime assets",
    inspect_signals = "Inspecting audio/animation/effects",
    get_runtime_code = "Reading Runtime editor",
    set_runtime_code = "Writing code to Runtime editor",
    run_runtime_code = "Running Runtime code",
    stop_runtime_code = "Stopping Runtime code",
    fetch_url = "Researching a reference",
    create_code = "Generating code"
}

function renderToolEvent(toolName, step, detail)
    local friendly = friendlyTools[toolName] or ("Running " .. tostring(toolName))
    local text = friendly .. (detail and detail ~= "" and (" • " .. detail) or "")
    statusLabel.Text = string.format("Step %d/%d • %s", step, state.maxAgentSteps, friendly)
    setActivity(string.format("Step %d/%d  %s…", step, state.maxAgentSteps, text))
end

local function clip(text, max)
    text = tostring(text or "")
    text = text:gsub("%s+", " ")
    if #text > max then return text:sub(1, max - 1) .. "…" end
    return text
end

function describeToolArgs(name, args)
    args = type(args) == "table" and args or {}
    local bits = {}
    local function add(label, value)
        if value ~= nil and tostring(value) ~= "" then
            table.insert(bits, label .. clip(value, 40))
        end
    end

    if name == "set_runtime_code" then
        add("", tostring(#tostring(args.code or "")) .. " chars" .. (args.run and " + run" or ""))
    elseif name == "fetch_url" then
        add("", args.url)
    elseif name == "inspect_instance" then
        add("", args.path)
    elseif name == "get_remote_call" then
        add("#", args.id)
    elseif name == "read_session_log" then
        add("", args.kinds)
        add("level=", args.level)
        add("", args.query)
    elseif name == "run_runtime_code" then
        add("", "executing")
    else
        add("", args.query)
        add("remote=", args.remote)
        add("class=", args.class)
        add("scope=", args.scope)
        add("dir=", args.direction)
        add("action=", args.action)
        add("after #", args.after_id)
        add("limit ", args.limit)
    end
    return table.concat(bits, " ")
end

function summarizeToolResult(name, result)
    if type(result) ~= "table" then return true, "done" end
    if result.ok == false then
        return false, clip(result.error or "failed", 90)
    end
    local runInfo = type(result.run) == "table" and result.run or (result.errorCount ~= nil and result or nil)
    if runInfo and runInfo.errorCount and runInfo.errorCount > 0 then
        return false, clip(tostring(runInfo.errorCount) .. " error(s): " .. tostring(runInfo.errors and runInfo.errors[1] or "see console"), 110)
    end

    local bits = {}
    local function add(text) table.insert(bits, text) end

    if result.count ~= nil then add(tostring(result.count) .. " results") end
    if result.returned ~= nil then add(tostring(result.returned) .. " returned") end
    if result.totalRemotesSeen ~= nil then add(tostring(result.totalRemotesSeen) .. " remotes seen") end
    if result.totalLogsStored ~= nil then add(tostring(result.totalLogsStored) .. " logs stored") end
    if result.childCount ~= nil then add(tostring(result.childCount) .. " children") end
    if result.totalDescendants ~= nil then add(tostring(result.totalDescendants) .. " objects") end
    if result.newlyAttached ~= nil then add(tostring(result.newlyAttached) .. " new remotes attached") end
    if result.length ~= nil then add(tostring(result.length) .. " chars written") end
    if result.cleared then add("log cleared") end
    if result.totalStored ~= nil then add(tostring(result.totalStored) .. " journal lines") end
    if type(result.run) == "table" then
        add(result.run.errorCount and result.run.errorCount > 0 and (tostring(result.run.errorCount) .. " ERRORS") or "ran clean")
    elseif result.errorCount ~= nil then
        add(result.errorCount > 0 and (tostring(result.errorCount) .. " ERRORS") or (result.stillRunning and "running, no errors" or "ran clean"))
    end
    if result.message then add(clip(result.message, 50)) end
    if result.spy and result.spy.outgoingCallsSeen ~= nil and (name:find("remote") or name == "get_live_remotes") then
        add(tostring(result.spy.outgoingCallsSeen) .. " out / " .. tostring(result.spy.incomingEventsSeen) .. " in total")
    end
    local scan = result.scan or result.progress
    if type(scan) == "table" and scan.processed then
        add("scanned " .. tostring(scan.processed) .. " in " .. tostring(scan.elapsedSeconds) .. "s")
    end
    if result.truncated then add("trimmed for size") end
    if #bits == 0 then add("done") end
    return true, table.concat(bits, " • ")
end

function packToolResult(result)
    local encoded
    local ok = pcall(function()
        encoded = HttpService:JSONEncode(result)
    end)

    if not ok then
        return '{"ok":false,"error":"Tool result could not be encoded."}'
    end

    local LIMIT = 50000
    if #encoded > LIMIT then
        local wrapped
        pcall(function()
            wrapped = HttpService:JSONEncode({
                ok = true,
                truncated = true,
                originalChars = #encoded,
                note = "Result was too large and was cut. Narrow it with filters, a smaller limit, or paging (offset_from_end / after_id) and call again.",
                partial = encoded:sub(1, LIMIT)
            })
        end)
        return wrapped or encoded:sub(1, LIMIT)
    end

    return encoded
end

end

local function sendToAgent(userText)
    local prompt = userText

    if state.codeMode then
        prompt =
            "CODE MODE (vibe coding).\n"
            .. "Build this in the Runtime tab right now: call set_runtime_code with run=true, read the errors and "
            .. "console output it returns, fix and re-run until it runs clean, then give a short summary. "
            .. "Look up real names, paths and remote arguments with the inspect/search/remote tools instead of guessing. "
            .. "Do not paste the full script into chat and do not ask for permission.\n\n"
            .. userText
    end

    journalAdd("agent", "user: " .. tostring(userText):sub(1, 300), "user")

    table.insert(conversationHistory, {
        role = "user",
        content = prompt
    })

    while #conversationHistory > 24 do
        table.remove(conversationHistory, 1)
    end

    local messages = {
        {
            role = "system",
            content = buildSystemPrompt()
        }
    }

    for _, item in ipairs(conversationHistory) do
        table.insert(messages, item)
    end

    local maxSteps = state.agentMode and state.maxAgentSteps or 1

    for step = 1, maxSteps do
        renderToolEvent("thinking", step, "waiting for " .. shortModelName(state.currentModel)
            .. (state.activeKey ~= "" and (" (key " .. state.activeKey .. ")") or ""))

        local ok, assistantMessage, errorMessage = openRouterRequest(
            messages,
            state.agentMode
        )

        if not ok then
            return false, nil, errorMessage
        end

        table.insert(messages, assistantMessage)

        local toolCalls = assistantMessage.tool_calls

        if type(toolCalls) ~= "table" or #toolCalls == 0 then
            local answer = assistantMessage.content

            if type(answer) ~= "string" then
                answer = tostring(answer or "")
            end

            if answer == "" then
                answer = "The agent finished without a text response."
            end

            table.insert(conversationHistory, {
                role = "assistant",
                content = answer
            })

            while #conversationHistory > 24 do
                table.remove(conversationHistory, 1)
            end

            return true, answer, nil
        end

        for _, call in ipairs(toolCalls) do
            local fn = call["function"] or {}
            local name = fn.name
            local rawArguments = fn.arguments or "{}"

            local args = {}
            local parseOk = pcall(function()
                args = HttpService:JSONDecode(rawArguments)
            end)

            if not parseOk or type(args) ~= "table" then
                args = {}
            end

            local detail = describeToolArgs(name, args)
            renderToolEvent(name or "tool", step, detail)

            local chip = createToolChip(friendlyTools[name] or tostring(name), detail)
            chip.running("running…")

            local callOk, result = pcall(executeTool, name, args)
            if not callOk then
                result = { ok = false, error = "Tool crashed: " .. tostring(result) }
            end

            local summaryOk, summaryText = summarizeToolResult(name or "", result)
            chip.finish(summaryOk, summaryText)
            journalAdd("agent", tostring(name) .. " " .. detail .. " -> " .. summaryText, summaryOk and "ok" or "failed")

            local encodedResult = packToolResult(result)

            table.insert(messages, {
                role = "tool",
                tool_call_id = call.id,
                content = encodedResult
            })

            -- Show generated code artifacts immediately.
            if name == "create_code" and result.ok then
                createCodeBlock(
                    result.code,
                    tostring(result.filename or "GENERATED CODE")
                )
            end
        end
    end

    -- Give the model one final non-tool response after the step limit.
    local finalMessages = {
        {
            role = "system",
            content = buildSystemPrompt()
                .. "\n\nThe tool-step limit was reached. Summarize what you discovered and what remains."
        }
    }

    for _, item in ipairs(messages) do
        table.insert(finalMessages, item)
    end

    local ok, finalMessage, errorMessage = openRouterRequest(
        finalMessages,
        false
    )

    if not ok then
        return false, nil, errorMessage
    end

    local answer = tostring(finalMessage.content or "Agent reached its step limit.")
    table.insert(conversationHistory, {
        role = "assistant",
        content = answer
    })

    return true, answer, nil
end

