local function getFileAPI(name)
    local ok, value = pcall(function()
        return _G[name]
    end)
    if ok and type(value) == "function" then
        return value
    end

    local ok2, value2 = pcall(function()
        return getfenv()[name]
    end)
    if ok2 and type(value2) == "function" then
        return value2
    end

    return nil
end

local readfileFn = readfile or getFileAPI("readfile")
local writefileFn = writefile or getFileAPI("writefile")
local isfileFn = isfile or getFileAPI("isfile")
local delfileFn = delfile or getFileAPI("delfile")

local function safeReadFile(path)
    if type(readfileFn) ~= "function" or type(isfileFn) ~= "function" then
        return nil
    end

    local exists = pcall(function()
        return isfileFn(path)
    end)

    if not exists then
        return nil
    end

    local ok, data = pcall(function()
        if not isfileFn(path) then
            return nil
        end
        return readfileFn(path)
    end)

    if ok and type(data) == "string" then
        return data
    end

    return nil
end

local function safeWriteFile(path, data)
    if type(writefileFn) ~= "function" then
        return false
    end

    local ok = pcall(function()
        writefileFn(path, data)
    end)

    return ok
end

local function safeDeleteFile(path)
    if type(delfileFn) ~= "function" or type(isfileFn) ~= "function" then
        return false
    end

    local ok = pcall(function()
        if isfileFn(path) then
            delfileFn(path)
        end
    end)

    return ok
end

