    if not ok or not response then
        return false, nil, "Network request failed."
    end

    local status = tonumber(response.StatusCode) or 0

    if status < 200 or status >= 300 then
        return false, nil, handleOpenRouterError(status, response.Body), classifyKeyProblem(status, response.Body)
    end

    local decodedOk, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedOk or type(decoded) ~= "table" then
        return false, nil, "The server returned invalid JSON."
    end

    if decoded.error then
        local message = tostring(decoded.error.message or "Unknown API error.")
        return false, nil, message, classifyKeyProblem(tonumber(decoded.error.code) or 0, message)
    end

    local choice = decoded.choices and decoded.choices[1]
    if not choice or not choice.message then
        return false, nil, "The AI returned an empty response."
    end

    return true, choice.message, nil
end

function openRouterRequest(messages, useTools)
    if #state.keys == 0 or trim(state.apiKey) == "" then
        return false, nil, "No OpenRouter API key is set. Open ⚙ Settings, give the key a name and tap Add key."
    end

    local payload = {
        model = state.currentModel,
        messages = messages,
        max_tokens = 4096
    }

    if useTools then
        local activeTools = getActiveToolDefinitions()
        if #activeTools > 0 then
            payload.tools = activeTools
            payload.tool_choice = "auto"
        end
    end

    local attempts = 0
    while true do
        attempts += 1
        local ok, message, err, keyProblem = requestWithKey(state.apiKey, payload)

        if ok then
            return true, message, nil
        end

        if keyProblem == "hit the daily free-model limit" or keyProblem == "hit a rate limit" then
            err = tostring(err) .. "\n(Free models are limited per account per day, so another key from the same account will not help. Use a paid model, add credits, or wait.)"
        end

        if not state.autoSwitchKeys or not keyProblem or #state.keys < 2 or attempts > #state.keys then
            return false, nil, err
        end

        local oldName = state.activeKey
        exhaustedKeys[oldName] = os.clock() + KEY_COOLDOWN_SECONDS
        local nextIndex = nextUsableKeyIndex(findKeyIndex(oldName) or 1)

        if not nextIndex then
            return false, nil, "Every saved API key failed (last: '" .. oldName .. "' " .. keyProblem
                .. "). Add a fresh key in ⚙ Settings.\n" .. tostring(err)
        end

        state.activeKey = state.keys[nextIndex].name
        syncActiveKey()
        pcall(saveState)

        local switchText = "🔑 Switched API key: " .. oldName .. " → " .. state.activeKey
            .. "  (" .. oldName .. " " .. keyProblem .. ")"
        createNotice(switchText)
        journalAdd("system", switchText, "key")

        if onKeySwitched then pcall(onKeySwitched) end
    end
end

end

