local generatedArtifacts = {}

local function toolCreateCode(args)
    local language = trim(args and args.language or "lua")
    local filename = trim(args and args.filename or ("Generated_" .. tostring(#generatedArtifacts + 1) .. ".lua"))
    local code = tostring(args and args.code or "")

    if code == "" then
        return { ok = false, error = "Code is empty." }
    end

    if #code > 50000 then
        code = code:sub(1, 50000) .. "\n-- [truncated by agent]"
    end

    local artifact = {
        id = #generatedArtifacts + 1,
        language = language,
        filename = filename,
        code = code
    }

    table.insert(generatedArtifacts, artifact)

    return {
        ok = true,
        artifact_id = artifact.id,
        filename = filename,
        language = language,
        code = code,
        execution = "not executed"
    }
end

