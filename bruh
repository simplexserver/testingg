    if profile.logs ~= math.huge then limit = math.min(limit, profile.logs) end
    local floorIndex = 1
    if profile.logs ~= math.huge then floorIndex = math.max(1, total - profile.logs + 1) end
    local query = string.lower(trim(args.query or ""))
    local typeFilter = trim(args.type or "") ~= "" and normalizeLevel(args.type) or ""
    -- offset_from_end lets the AI page backwards through the ENTIRE log.
    local offset = math.max(0, math.floor(tonumber(args.offset_from_end) or 0))

    local matches = {}
    for i = total - offset, floorIndex, -1 do
        local item = consoleLogs[i]
