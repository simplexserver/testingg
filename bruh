local function deleteKey(name)
    local index = findKeyIndex(name)
    if not index then return end
    table.remove(state.keys, index)
    if state.activeKey == name then
        state.activeKey = state.keys[1] and state.keys[1].name or ""
    end
    syncActiveKey()
    if not saveState(true) then
        -- keep going; file APIs may be unavailable
    end
    refreshKeyStatus()
end

