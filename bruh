    pushBounded(consoleLogs, {
        id = consoleLogs.seq,
        time = os.clock(),
        type = tostring(messageType or "Message"),
        message = tostring(message or "")
    }, MAX_CONSOLE_LOGS)
    if journalAdd then
        journalAdd("console", message, normalizeLevel(messageType))
    end
end

