local function runRuntimeCode(code, source)
    if not state.permissions.codeRun then
        return false, "AI/user runtime execution is disabled in Settings."
    end

    code = tostring(code or "")
    if trim(code) == "" then
        return false, "Runtime code is empty."
    end

    stopRuntimeCode()
    runtimeRunId += 1
    local thisRun = runtimeRunId

    local compiler = loadstring
    if type(compiler) ~= "function" then
        return false, "This executor does not expose loadstring, so Runtime cannot execute code here."
    end

    local fn, compileError = loadstring(code, "SimpleX_Runtime")
    if type(fn) ~= "function" then
        return false, "Compile error: " .. tostring(compileError)
    end

    if runtimeStatusLabel then
        runtimeStatusLabel.Text = "Running " .. tostring(source or "runtime") .. "..."
        runtimeStatusLabel.TextColor3 = COLORS.Green
    end

    journalAdd("runtime", "run started (" .. tostring(source or "runtime") .. ", " .. tostring(#code) .. " chars)", "start")

    local runFinished = false
    local runThread = task.spawn(function()
        local ok, err = pcall(fn)
        runFinished = true
        if thisRun ~= runtimeRunId then return end
        if ok then
            journalAdd("runtime", "run finished without errors", "finish")
            if runtimeStatusLabel then
                runtimeStatusLabel.Text = "Finished — no active runtime thread."
                runtimeStatusLabel.TextColor3 = COLORS.Gray
            end
        else
            addConsoleLog("RuntimeError", tostring(err))
            if runtimeStatusLabel then
                runtimeStatusLabel.Text = "Runtime error — see Console."
                runtimeStatusLabel.TextColor3 = COLORS.Red
            end
        end
        clearRuntimeThread()
    end)

    -- A script that finishes before its first yield has already cleared itself;
    -- do not resurrect it as "still running".
    if not runFinished and thisRun == runtimeRunId then
        activeRuntimeThread = runThread
    end

    return true, "Runtime started."
end

