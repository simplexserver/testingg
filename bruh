local function safeFullName(instance)
    local ok, value = pcall(function()
        return instance:GetFullName()
    end)
    return ok and value or instance.Name
end

local function describeInstance(instance)
    local result = {
        name = instance.Name,
        className = instance.ClassName,
        fullName = safeFullName(instance)
    }

    if instance:IsA("BasePart") then
        result.position = {
            x = math.floor(instance.Position.X * 100) / 100,
            y = math.floor(instance.Position.Y * 100) / 100,
            z = math.floor(instance.Position.Z * 100) / 100
        }
        result.size = {
            x = math.floor(instance.Size.X * 100) / 100,
            y = math.floor(instance.Size.Y * 100) / 100,
            z = math.floor(instance.Size.Z * 100) / 100
        }
    elseif instance:IsA("Humanoid") then
        result.health = instance.Health
        result.maxHealth = instance.MaxHealth
    elseif instance:IsA("Model") then
        local primary = instance.PrimaryPart
        if primary then
            result.primaryPart = primary.Name
            result.position = {
                x = math.floor(primary.Position.X * 100) / 100,
                y = math.floor(primary.Position.Y * 100) / 100,
                z = math.floor(primary.Position.Z * 100) / 100
            }
        end
    elseif instance:IsA("Sound") then
        result.soundId = tostring(instance.SoundId)
        result.playing = instance.Playing
        result.volume = instance.Volume
        result.playbackSpeed = instance.PlaybackSpeed
        result.timePosition = instance.TimePosition
    elseif instance:IsA("Animation") then
        result.animationId = tostring(instance.AnimationId)
    elseif instance:IsA("ParticleEmitter") then
        result.enabled = instance.Enabled
        result.rate = instance.Rate
        result.lifetime = tostring(instance.Lifetime)
    elseif instance:IsA("Beam") or instance:IsA("Trail") then
        result.enabled = instance.Enabled
    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        result.texture = tostring(instance.Texture)
    elseif instance:IsA("ProximityPrompt") then
        result.enabled = instance.Enabled
        result.actionText = instance.ActionText
        result.objectText = instance.ObjectText
        result.maxActivationDistance = instance.MaxActivationDistance
    elseif instance:IsA("ClickDetector") then
        result.maxActivationDistance = instance.MaxActivationDistance
    elseif instance:IsA("Highlight") then
        result.enabled = instance.Enabled
        result.depthMode = tostring(instance.DepthMode)
    elseif instance:IsA("ValueBase") then
        local ok, value = pcall(function()
            return instance.Value
        end)
        if ok then
            result.value = tostring(value)
        end
    end

    return result
end

local function resolvePath(path)
    path = trim(path)

    if path == "" or path == "game" then
        return game
    end

    local current = game
    local parts = {}

    for part in path:gmatch("[^%.]+") do
        table.insert(parts, part)
    end

    if parts[1] == "game" then
        table.remove(parts, 1)
    end

    for _, part in ipairs(parts) do
        local nextInstance

        local ok = pcall(function()
            nextInstance = current:FindFirstChild(part)
        end)

        if not ok or not nextInstance then
            return nil, "Could not resolve path at: " .. part
        end

        current = nextInstance
    end

    return current
end

local function toolInspectWorkspace(args)
    local query = string.lower(trim(args and args.query or ""))
    local requested = tonumber(args and args.limit)
    local limit = math.clamp(math.floor(requested or 80), 1, 2000)
    local profile = getScanProfile()
    if profile.maxItems ~= math.huge then limit = math.min(limit, profile.maxItems) end
    local started = os.clock()
    local processed = 0
    local items = {}

    for _, instance in ipairs(workspace:GetDescendants()) do
        processed += 1
        if #items >= limit then break end
        if profile.maxItems ~= math.huge and processed > profile.maxItems then break end

        local name = string.lower(instance.Name)
        local className = string.lower(instance.ClassName)

        if query == ""
            or string.find(name, query, 1, true)
            or string.find(className, query, 1, true) then
            table.insert(items, describeInstance(instance))
        end
        if processed % 800 == 0 then
            setActivity("Scanning workspace… " .. tostring(processed) .. " objects")
            task.wait(getScanDelay())
        end
    end

    return {
        ok = true,
        query = query,
        count = #items,
