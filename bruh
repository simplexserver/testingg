-- Different executors expose different protected GUI containers. Prefer
-- gethui() when available, then CoreGui, then PlayerGui as a compatibility
-- fallback. This keeps the script usable across common executor APIs.
local function getExecutorGuiParents()
    local parents = {}
    local seen = {}

    local function add(parent)
        if parent and not seen[parent] then
            seen[parent] = true
            table.insert(parents, parent)
        end
    end

    pcall(function()
        if type(gethui) == "function" then
            add(gethui())
        end
    end)

    -- PlayerGui is often the most compatible fallback because it does not
    -- require an executor-specific CoreGui permission.
    if LocalPlayer then
        pcall(function()
            add(LocalPlayer:FindFirstChildOfClass("PlayerGui"))
            add(LocalPlayer:WaitForChild("PlayerGui", 3))
        end)
    end

    add(CoreGui)
    return parents
end

local executorGuiParents = getExecutorGuiParents()

if #executorGuiParents == 0 then
    error("SimpleX Vibe Agent: no usable GUI container was found.")
end

local function attachExecutorGui(gui)
    pcall(function()
        if syn and type(syn.protect_gui) == "function" then
            syn.protect_gui(gui)
        end
    end)

    for _, parent in ipairs(executorGuiParents) do
        local ok = pcall(function()
            gui.Parent = parent
        end)
        if ok and gui.Parent == parent then
            return true
        end
    end

    return false
end

for _, parent in ipairs(executorGuiParents) do
    pcall(function()
        local old = parent:FindFirstChild("AIChatWindow")
        if old then old:Destroy() end
        local oldToggle = parent:FindFirstChild("AIChatToggle")
        if oldToggle then oldToggle:Destroy() end
    end)
end

