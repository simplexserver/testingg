-- SESSION JOURNAL: one live, unified timeline (console, remotes, runtime, agent
-- steps, workspace scans) kept in memory AND mirrored to a file, so the AI can
-- read everything with a single instant call instead of re-scanning.
local journalRead, journalDigest, JOURNAL_FILE
do
    JOURNAL_FILE = "SimpleX_VibeAgent_Session.log"
    local journal = {seq = 0, lines = {}, dirty = false, t0 = os.clock(),
        date = (type(os.date) == "function" and os.date("%Y-%m-%d %H:%M:%S")) or "?", counts = {}}

    local function cap()
        return getScanProfile().journal
    end

    journalAdd = function(kind, text, level)
        text = tostring(text or ""):gsub("[\r\n]+", " ⏎ ")
        if #text > 1500 then text = text:sub(1, 1500) .. "…" end

        journal.seq += 1
        journal.counts[kind] = (journal.counts[kind] or 0) + 1
        local lines = journal.lines
        lines[#lines + 1] = {seq = journal.seq, t = os.clock() - journal.t0, kind = kind, level = level or "", text = text}

        local limit = cap()
        if #lines > limit + 500 then
            local drop = #lines - limit
            table.move(lines, drop + 1, #lines, 1)
            for i = #lines - drop + 1, #lines do lines[i] = nil end
        end
        journal.dirty = true
    end

    local function formatLine(e)
        local tag = e.kind
        if e.level ~= "" then tag = tag .. "/" .. e.level end
        return string.format("[%d] +%.2fs %s %s", e.seq, e.t, tag, e.text)
    end

    local function flush()
        local parts = {
            "# SimpleX Vibe Agent live session log (rewritten while the session runs)",
            "# started " .. journal.date .. "  place " .. tostring(game.PlaceId) .. "  job " .. tostring(game.JobId) .. "  scan " .. tostring(state.scanMode),
            "# format: [seq] +seconds kind/level text   (kinds: console, remote, runtime, agent, workspace, system)"
        }
        for _, e in ipairs(journal.lines) do parts[#parts + 1] = formatLine(e) end
        journal.dirty = false
        pcall(safeWriteFile, JOURNAL_FILE, table.concat(parts, "\n"))
    end

    task.spawn(function()
        while screenGui.Parent do
            task.wait(#journal.lines > 8000 and 10 or 3)
            if journal.dirty then pcall(flush) end
        end
    end)

    journalRead = function(args)
        args = args or {}
        local profile = getScanProfile()
        local kinds = nil
        local kindText = string.lower(trim(args.kinds or ""))
        if kindText ~= "" then
            kinds = {}
            for token in kindText:gmatch("[^,%s]+") do kinds[token] = true end
        end

        local level = normalizeLevel(args.level or "")
        if trim(args.level or "") == "" then level = "" end
        local query = string.lower(trim(args.query or ""))
        local afterSeq = tonumber(args.after_seq) or 0
        local limit = math.clamp(math.floor(tonumber(args.limit) or 200), 1, 5000)
        if profile.logs ~= math.huge then limit = math.min(limit, profile.logs) end

        local lines = journal.lines
        local floorIndex = 1
        if profile.logs ~= math.huge then
            floorIndex = math.max(1, #lines - profile.logs * 3 + 1)
        end

        local picked = {}
        local oldestIndex = nil
        for i = #lines, floorIndex, -1 do
            local e = lines[i]
            if e.seq <= afterSeq then break end
            local okKind = kinds == nil or kinds[e.kind]
            local okLevel = level == "" or e.level == level
                or (level == "error" and (e.level == "runtimeerror"))
                or (level == "warning" and e.level == "error" and false)
            local okQuery = query == "" or string.find(string.lower(e.text), query, 1, true)
            if okKind and okLevel and okQuery then
                table.insert(picked, 1, formatLine(e))
                oldestIndex = i
                if #picked >= limit then break end
            end
        end

        local top = {}
        for name, count in pairs(workspaceStats.byClass or {}) do
            table.insert(top, {name = name, count = count})
        end
        table.sort(top, function(a, b) return a.count > b.count end)
        local topClasses = {}
        for i = 1, math.min(15, #top) do topClasses[i] = top[i].name .. "=" .. top[i].count end

        return {
            ok = true,
            file = JOURNAL_FILE,
            scanMode = state.scanMode,
            totalStored = #lines,
            newestSeq = journal.seq,
            returned = #picked,
            hasMoreOlder = oldestIndex ~= nil and oldestIndex > 1,
            countsByKind = journal.counts,
            workspaceSnapshot = {
                totalDescendants = workspaceStats.total,
                secondsSinceScan = workspaceStats.lastScan > 0 and math.floor((os.clock() - workspaceStats.lastScan) * 10) / 10 or nil,
                topClasses = topClasses
            },
            lines = picked,
            hint = "Pass after_seq=<newestSeq> next time to read only what is new. Filter with kinds (console,remote,runtime,agent,workspace,system), level (error, warning, output, info) and query."
        }
    end

    journalDigest = function()
        local out = {}
        local lines = journal.lines
        local errorsFound, remotesFound = 0, 0
        for i = #lines, math.max(1, #lines - 400), -1 do
            local e = lines[i]
            if errorsFound < 6 and (e.level == "error" or e.level == "runtimeerror" or e.level == "warning") then
                table.insert(out, 1, "  " .. formatLine(e):sub(1, 220))
                errorsFound += 1
            end
        end
        return #lines, out
    end
end

