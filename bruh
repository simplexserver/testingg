local function renderAIResponse(text)
    local rendered = 0

    for _, segment in ipairs(splitFences(text)) do
        local body = trim(segment.body)
        if body ~= "" then
            if segment.kind == "code" then
                createCodeBlock(segment.body, segment.lang ~= "" and string.upper(segment.lang) or "CODE")
            else
                createMessage(body, true, false)
            end
            rendered += 1
        end
    end

    if rendered == 0 then
        createMessage(tostring(text or ""), true, false)
    end
end

