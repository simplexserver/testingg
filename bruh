local function clampWindowToScreen()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    local width = mainFrame.AbsoluteSize.X
    local height = mainFrame.AbsoluteSize.Y

    if width <= 0 or height <= 0 then return end

    local minX = -(viewport.X / 2) + width / 2 + 4
    local maxX = (viewport.X / 2) - width / 2 - 4
    local minY = -(viewport.Y / 2) + height / 2 + 4
    local maxY = (viewport.Y / 2) - height / 2 - 4

    mainFrame.Position = UDim2.new(
        0.5,
        math.clamp(mainFrame.Position.X.Offset, minX, maxX),
        0.5,
        math.clamp(mainFrame.Position.Y.Offset, minY, maxY)
    )
end

local function updateResponsiveLayout()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    local mobile = UserInputService.TouchEnabled or viewport.X < 600

