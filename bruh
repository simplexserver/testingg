        return
    end

    inputTextBox.Text = ""
    inputTextBox:SetAttribute("SelectedCommand", nil)
    commandMenu.Visible = false

    createMessage(userText, false, false)

    typingIndicator.Visible = not state.showActivity
    beginActivityClock()
    setActivity(state.showActivity and "Sending to the model…" or "")
    updateCanvas()

    requestBusy = true

    local started = os.clock()
    setStatus("processing", state.agentMode and "Agent thinking..." or "Thinking...")

    task.spawn(function()
        local ok, answer, errorMessage = sendToAgent(userText)
        local latency = math.floor((os.clock() - started) * 1000)

        requestBusy = false
        typingIndicator.Visible = false
        endActivityClock()

        if not ok then
            setStatus("error", "Agent error")
            createMessage(
                tostring(errorMessage or "Unknown request error."),
                true,
                true
            )
            updateCanvas()
            return
        end

        setStatus(
            "connected",
            (state.agentMode and "Agent complete • " or "Connected • ") .. latency .. "ms"
        )

        if answer and trim(answer) ~= "" then
            renderAIResponse(answer)
        end

        updateCanvas()
    end)
end

