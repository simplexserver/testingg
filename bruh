local function makeScanProgress(kind, started, processed, totalHint)
    local elapsed = os.clock() - started
    local rate = elapsed > 0 and (processed / elapsed) or 0
    local remaining
    if totalHint and totalHint > 0 and rate > 0 then
        remaining = math.max(0, totalHint - processed) / rate
    end
    return {
        kind = kind,
        processed = processed,
        elapsedSeconds = math.floor(elapsed * 100) / 100,
        itemsPerSecond = math.floor(rate * 10) / 10,
        estimatedRemainingSeconds = remaining and math.floor(remaining * 10) / 10 or nil
    }
end

local function refreshWorkspaceSnapshot(args)
    args = args or {}
    local profile = getScanProfile()
    local started = os.clock()
    local query = string.lower(trim(args.query or ""))
    local collectAssets = args.collectAssets == true
    local byClass = {}
    local total = 0
    local assets = {}
    local assetSeen = {}
    local processed = 0
    local maxItems = tonumber(args.maxItems) or profile.maxItems
    if maxItems ~= math.huge then maxItems = math.max(1, math.floor(maxItems)) end

    local ok, err = pcall(function()
        for _, instance in ipairs(workspace:GetDescendants()) do
            processed += 1
            if maxItems ~= math.huge and processed > maxItems then break end

            total += 1
            byClass[instance.ClassName] = (byClass[instance.ClassName] or 0) + 1

            if collectAssets then
                local assetId
                if instance:IsA("Sound") then
                    assetId = collectAssetId(instance.SoundId)
                elseif instance:IsA("Animation") then
                    assetId = collectAssetId(instance.AnimationId)
                elseif instance:IsA("Decal") or instance:IsA("Texture") then
                    assetId = collectAssetId(instance.Texture)
                elseif instance:IsA("MeshPart") then
                    assetId = collectAssetId(instance.MeshId)
                elseif instance:IsA("SpecialMesh") then
                    assetId = collectAssetId(instance.MeshId)
                end

                if assetId and not assetSeen[assetId] and #assets < 5000 then
                    assetSeen[assetId] = true
                    table.insert(assets, assetId)
                end
            end

            if processed % 800 == 0 then
                setActivity("Scanning " .. "workspace" .. "… " .. tostring(processed) .. " objects")
                task.wait(getScanDelay())
            end
        end
    end)

    if ok then
        journalAdd("workspace", "workspace scan: " .. tostring(total) .. " objects in " .. string.format("%.1f", os.clock() - started) .. "s", "scan")
        workspaceStats.total = total
        workspaceStats.byClass = byClass
        workspaceStats.lastScan = os.clock()
        workspaceStats.lastAssetScan = collectAssets and os.clock() or workspaceStats.lastAssetScan
        workspaceStats.assetCount = #assets
        workspaceStats.assetIds = assets
    end

    return {
        ok = ok,
        error = ok and nil or tostring(err),
        progress = makeScanProgress("workspace", started, processed),
        totalDescendants = total,
        byClass = byClass,
        assetCount = #assets,
        assetIds = assets
    }
end

