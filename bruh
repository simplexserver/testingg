local function addKeyFromUI()
    local value = trim(keyBox.Text)
    if value == "" then
        setKeyStatus("Paste a key first.", COLORS.Yellow)
        return
    end

    local name = trim(keyNameBox.Text)
    if name == "" then name = "api" .. tostring(#state.keys + 1) end

    local base, suffix = name, 2
    while findKeyIndex(name) do
        name = base .. "_" .. tostring(suffix)
        suffix += 1
    end

    table.insert(state.keys, {name = name, key = value})
    if state.activeKey == "" or #state.keys == 1 then
        state.activeKey = name
    end
    syncActiveKey()

    keyBox.Text = ""
    keyNameBox.Text = ""

    local saved = saveState(true)
    refreshKeyStatus()
    if not saved then
        setKeyStatus("Added '" .. name .. "' for this run; executor file saving is unavailable.", COLORS.Yellow)
    end
end

