local function showCommands(filter)
    for _, child in ipairs(commandMenu:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    filter = string.lower(filter or "")
    local shown = 0

    for _, info in ipairs(commands) do
        if filter == ""
            or string.find(string.lower(info.command), filter, 1, true) then

            shown += 1

            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, 0, 0, 27)
            button.BackgroundColor3 = COLORS.Panel2
            button.BorderSizePixel = 0
            button.Text = info.command .. "   " .. info.description
            button.TextColor3 = COLORS.White
            button.Font = Enum.Font.Gotham
            button.TextSize = 10
            button.TextXAlignment = Enum.TextXAlignment.Left
            button.AutoButtonColor = false
            button.Active = true
            button.ZIndex = 501
            button.Parent = commandMenu

            local padding = Instance.new("UIPadding")
            padding.PaddingLeft = UDim.new(0, 10)
            padding.Parent = button
            makeCorner(button, 6)

            button.MouseButton1Click:Connect(function()
                inputTextBox.Text = info.command
                inputTextBox.CursorPosition = #info.command + 1
                inputTextBox:SetAttribute("SelectedCommand", info.command)
                commandMenu.Visible = false
                inputTextBox:CaptureFocus()
            end)
        end
    end

    if shown > 0 then
        commandMenu.Size = UDim2.new(1, -20, 0, math.clamp(10 + shown * 30, 40, 190))
        commandMenu.Position = UDim2.new(0, 10, 1, -68)
        commandMenu.Visible = true
    else
        commandMenu.Visible = false
    end
end

inputTextBox:GetPropertyChangedSignal("Text"):Connect(function()
    local text = inputTextBox.Text
    local selected = inputTextBox:GetAttribute("SelectedCommand")

    if selected and text ~= selected then
        inputTextBox:SetAttribute("SelectedCommand", nil)
    end

    if string.sub(text, 1, 1) == "/" then
        local commandPart = string.match(text, "^/(%S*)$")
        if commandPart ~= nil then
            showCommands("/" .. commandPart)
        else
            commandMenu.Visible = false
        end
    else
        commandMenu.Visible = false
    end
end)

