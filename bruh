local function collectRuntimeOutcome(waitSeconds, startId)
    waitSeconds = math.clamp(tonumber(waitSeconds) or 2.5, 0, 20)
    local deadline = os.clock() + waitSeconds
    repeat
        task.wait(0.1)
    until activeRuntimeThread == nil or os.clock() >= deadline

    local lines, errors = {}, {}
    local firstIndex = #consoleLogs
    for i = #consoleLogs, 1, -1 do
        local item = consoleLogs[i]
        if item.id and item.id <= startId then break end
        firstIndex = i
    end
    for i = firstIndex, #consoleLogs do
        local item = consoleLogs[i]
        if item.id and item.id > startId then
            local level = normalizeLevel(item.type)
            if #lines < 80 then table.insert(lines, level .. ": " .. item.message) end
            if level == "error" or level == "runtimeerror" then table.insert(errors, item.message) end
        end
    end

    local stillRunning = activeRuntimeThread ~= nil
    return {
        finished = not stillRunning,
        stillRunning = stillRunning,
        errorCount = #errors,
        errors = errors,
        newConsoleLines = lines,
        verdict = #errors > 0 and "FAILED: fix the errors above with set_runtime_code (run=true) and try again."
            or (stillRunning and "Running with no errors so far (long-running script). Read logs again later if needed."
            or "Finished with no errors.")
    }
end

local function runWithReport(waitSeconds)
    local startId = consoleLogs.seq
    local ok, message = runRuntimeCode(runtimeCodeBox and runtimeCodeBox.Text or "", "AI runtime")
    if not ok then
        return { ok = false, started = false, error = message,
            verdict = "FAILED to start: " .. tostring(message) }
    end
    local report = collectRuntimeOutcome(waitSeconds, startId)
    report.ok = true
    report.started = true
    return report
end

