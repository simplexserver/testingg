-- This intentionally returns text only. It does not execute fetched code.

local function stripHtml(html)
    html = tostring(html or "")
    html = html:gsub("<script.->.-</script>", " ")
    html = html:gsub("<style.->.-</style>", " ")
    html = html:gsub("<[^>]->", " ")
    html = html:gsub("&nbsp;", " ")
    html = html:gsub("&amp;", "&")
    html = html:gsub("&lt;", "<")
    html = html:gsub("&gt;", ">")
    html = html:gsub("[ \t]+", " ")
    html = html:gsub("\n%s+\n", "\n\n")
    return html
end

local function toolFetchUrl(args)
    local url = trim(args and args.url or "")
    local maxChars = math.clamp(tonumber(args and args.max_chars) or 12000, 1000, 30000)

    if url == "" then
        return { ok = false, error = "URL is required." }
    end

    if not string.match(url, "^https?://") then
        return { ok = false, error = "Only http:// and https:// URLs are allowed." }
    end

    local req = getRequestFunction()
    if not req then
        return { ok = false, error = "No supported HTTP request function is available." }
    end

    local ok, response = pcall(function()
        return req({
            Url = url,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "SimpleX-VibeAgent"
            }
        })
    end)

    if not ok or not response then
        return { ok = false, error = "HTTP request failed." }
    end

    local status = tonumber(response.StatusCode) or 0
    if status < 200 or status >= 300 then
        return {
            ok = false,
            status = status,
            error = "URL returned HTTP status " .. tostring(status)
        }
    end

    local body = tostring(response.Body or "")
    local cleaned = stripHtml(body)

    if #cleaned > maxChars then
        cleaned = cleaned:sub(1, maxChars) .. "\n...[truncated]"
    end

    return {
        ok = true,
        url = url,
        status = status,
        content = cleaned
    }
end

