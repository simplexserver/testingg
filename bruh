--------------------------------------------------

local function processCommand(text)
    local command = string.lower(trim(text))

    if command == "/agent" then
        state.agentMode = not state.agentMode
        agentToggle.Text = state.agentMode and "ON" or "OFF"
        updateModeLabel()
        saveState()

        createMessage(
            "Agent mode is now " .. (state.agentMode and "ON" or "OFF") .. ".",
            true,
            false
        )
        return true
    end

    if command == "/code" then
        applyMode("CODE")
        createMessage("Code mode enabled.", true, false)
        return true
    end

    if command == "/chat" then
        applyMode("CHAT")
        createMessage("Normal chat mode enabled.", true, false)
        return true
    end

    if command == "/clear" then
        clearMessages()
        return true
    end

    if command == "/help" then
        createMessage(
