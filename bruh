        local okQuery = query == "" or string.find(string.lower(item.message), query, 1, true)
        if okType and okQuery then
            table.insert(matches, 1, {index = i, time = math.floor(item.time * 100) / 100, type = item.type, message = item.message})
            if #matches >= limit then break end
        end
    end

    return {
        ok = true,
        totalLogsStored = total,
        returned = #matches,
        scanMode = state.scanMode,
        hasMoreOlder = #matches > 0 and matches[1].index > floorIndex,
