local function pushBounded(list, value, max)
    list[#list + 1] = value
    -- trim in batches so very chatty games do not pay O(n) on every message
    if #list > max + 500 then
        local drop = #list - max
        table.move(list, drop + 1, #list, 1)
        for i = #list - drop + 1, #list do list[i] = nil end
    end
end

