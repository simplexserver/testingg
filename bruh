local function toolSearchGame(args)
    if not state.permissions.workspaceRead then
        return { ok = false, error = "AI workspace-read permission is disabled." }
    end

    args = args or {}
    local query = string.lower(trim(args.query or ""))
    local classFilter = string.lower(trim(args.class or ""))
    local scope = string.lower(trim(args.scope or "all"))
    local limit = math.clamp(math.floor(tonumber(args.limit) or 200), 1, 2000)
    local searchProfile = getScanProfile()
    if searchProfile.maxItems ~= math.huge then limit = math.min(limit, searchProfile.maxItems) end
    local includeText = args.search_text ~= false

    if query == "" and classFilter == "" then
        return { ok = false, error = "Provide query and/or class." }
    end

    local roots = {}
    local function addRoot(name, instance)
        if instance then table.insert(roots, {name = name, instance = instance}) end
    end

    local function service(name)
        local ok, value = pcall(function() return game:GetService(name) end)
        return ok and value or nil
    end

    if scope == "workspace" then
        addRoot("Workspace", workspace)
    elseif scope == "replicated" then
        addRoot("ReplicatedStorage", service("ReplicatedStorage"))
        addRoot("ReplicatedFirst", service("ReplicatedFirst"))
    elseif scope == "players" then
        addRoot("Players", service("Players"))
    elseif scope == "gui" then
        addRoot("PlayerGui", LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui"))
        addRoot("CoreGui", service("CoreGui"))
    elseif scope == "lighting" then
        addRoot("Lighting", service("Lighting"))
        addRoot("SoundService", service("SoundService"))
    else
        addRoot("game", game)
    end

    local started = os.clock()
    local processed = 0
    local items = {}
    local seen = {}

    local function consider(instance, rootName)
        if seen[instance] then return end
        seen[instance] = true
        processed += 1

        if searchProfile.maxItems ~= math.huge and processed > searchProfile.maxItems * 8 then return end

        local okInfo, name, className = pcall(function() return instance.Name, instance.ClassName end)
        if not okInfo then return end

        local nameLower = string.lower(name)
        local classLower = string.lower(className)
        local classOk = classFilter == "" or classLower == classFilter or string.find(classLower, classFilter, 1, true)
        if not classOk then return end

        local hit = query == "" or string.find(nameLower, query, 1, true) or string.find(classLower, query, 1, true)
        local matchedOn = hit and "name/class" or nil

        if not hit and includeText and query ~= "" then
            local okText, text = pcall(function()
                if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
                    return instance.Text
                elseif instance:IsA("ProximityPrompt") then
                    return tostring(instance.ActionText) .. " " .. tostring(instance.ObjectText)
                elseif instance:IsA("ValueBase") then
                    return tostring(instance.Value)
                end
                return nil
            end)
            if okText and type(text) == "string" and string.find(string.lower(text), query, 1, true) then
                hit = true
                matchedOn = "text/value"
            end
        end

        if hit and #items < limit then
            local info = describeInstance(instance)
            info.matchedOn = matchedOn
            info.root = rootName
            table.insert(items, info)
        end
    end

    local ok, err = pcall(function()
        for _, root in ipairs(roots) do
            consider(root.instance, root.name)
            for _, instance in ipairs(root.instance:GetDescendants()) do
                consider(instance, root.name)
                if #items >= limit then return end
                if processed % 1200 == 0 then
                    setActivity("Searching " .. root.name .. "… " .. tostring(processed) .. " objects, " .. tostring(#items) .. " matches")
                    task.wait()
                end
            end
        end

        if (scope == "all" or scope == "nil") and type(getnilinstances) == "function" then
            for _, instance in ipairs(getnilinstances()) do
                consider(instance, "nil (not parented to game)")
                if #items >= limit then return end
            end
        end
    end)

    return {
        ok = ok,
        error = ok and nil or tostring(err),
        query = query,
        class = classFilter ~= "" and classFilter or nil,
        scope = scope,
        count = #items,
        reachedLimit = #items >= limit,
        scan = makeScanProgress("search", started, processed),
        items = items,
        nextStep = #items == 0 and "No match. Try scope=\"all\", a shorter or partial query, a class filter, or search_text for GUI text; nil-parented instances are included in scope=all." or nil
    }
end

