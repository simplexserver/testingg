local exhaustedKeys = {}      -- key name -> os.clock() until which it is skipped
local KEY_COOLDOWN_SECONDS = 120

local function classifyKeyProblem(status, bodyText)
    local lower = string.lower(tostring(bodyText or ""))

    -- Rate limits first: OpenRouter's 429 text also says "Add 10 credits", which
    -- must NOT be mistaken for an empty balance.
    if string.find(lower, "free-models-per-day", 1, true) then
        return "hit the daily free-model limit"
    end

    if status == 429 or string.find(lower, "rate limit", 1, true) or string.find(lower, "rate-limit", 1, true) then
        return "hit a rate limit"
    end

    if status == 402 or string.find(lower, "insufficient credit", 1, true)
        or string.find(lower, "insufficient funds", 1, true) or string.find(lower, "out of credits", 1, true)
        or string.find(lower, "payment required", 1, true) or string.find(lower, "key limit exceeded", 1, true)
        or string.find(lower, "quota", 1, true) then
        return "ran out of credits/tokens"
    end

    if status == 401 then
        return "was rejected as invalid"
    end

    return nil
end

local function nextUsableKeyIndex(fromIndex)
    local count = #state.keys
    for offset = 1, count - 1 do
        local index = ((fromIndex - 1 + offset) % count) + 1
        local item = state.keys[index]
        if (exhaustedKeys[item.name] or 0) <= os.clock() then
            return index
        end
    end
    return nil
end

