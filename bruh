local function loadState()
    local raw = safeReadFile(CONFIG_FILE)
    if not raw then
        return
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or type(data) ~= "table" then
        return
    end

    if type(data.apiKey) == "string" then
        state.apiKey = data.apiKey
    end

    if type(data.currentModel) == "string" and data.currentModel ~= "" then
        state.currentModel = data.currentModel
    end

    if type(data.autoSaveKey) == "boolean" then
        state.autoSaveKey = data.autoSaveKey
    end

    if type(data.autoSaveConfig) == "boolean" then
        state.autoSaveConfig = data.autoSaveConfig
    end

    if type(data.keys) == "table" then
        for _, item in ipairs(data.keys) do
            if type(item) == "table" and type(item.key) == "string" and item.key ~= "" then
                table.insert(state.keys, {
                    name = type(item.name) == "string" and item.name ~= "" and item.name or ("api" .. tostring(#state.keys + 1)),
                    key = item.key
                })
            end
        end
    end

    -- Migrate the old single-key save format.
    if #state.keys == 0 and type(data.apiKey) == "string" and data.apiKey ~= "" then
        table.insert(state.keys, {name = "api1", key = data.apiKey})
    end

    if type(data.activeKey) == "string" then
        state.activeKey = data.activeKey
    end

    if type(data.spyEnabled) == "boolean" then
        state.spyEnabled = data.spyEnabled
    end

    if data.scanMode == "Light" or data.scanMode == "Medium" or data.scanMode == "Hard" or data.scanMode == "Max" then
        state.scanMode = data.scanMode
    end

    if type(data.autoSwitchKeys) == "boolean" then
        state.autoSwitchKeys = data.autoSwitchKeys
    end

    if type(data.logExecutorCalls) == "boolean" then
        state.logExecutorCalls = data.logExecutorCalls
    end

    if type(data.codeMode) == "boolean" then
        state.codeMode = data.codeMode
    end

    if type(data.agentMode) == "boolean" then
        state.agentMode = data.agentMode
    end

    if tonumber(data.maxAgentSteps) then
        state.maxAgentSteps = math.clamp(math.floor(tonumber(data.maxAgentSteps)), 1, 40)
    end

    if type(data.showActivity) == "boolean" then
        state.showActivity = data.showActivity
    end

    if type(data.permissions) == "table" then
        for key, value in pairs(data.permissions) do
            if type(value) == "boolean" and state.permissions[key] ~= nil then
                state.permissions[key] = value
            end
        end
    end

    if type(data.brain) == "table" then
        for key, value in pairs(data.brain) do
            if type(value) == "string" then
                state.brain[key] = value
            end
        end
    end
end

loadState()

local function findKeyIndex(name)
    for i, item in ipairs(state.keys) do
        if item.name == name then return i end
    end
    return nil
end

local function syncActiveKey()
    local index = findKeyIndex(state.activeKey) or 1
    local item = state.keys[index]
    if item then
        state.activeKey = item.name
        state.apiKey = item.key
    else
        state.activeKey = ""
        state.apiKey = ""
    end
end

syncActiveKey()

local function saveState(force)
    if not force and not state.autoSaveConfig and not state.autoSaveKey then
        return false
    end

    local savedKeys = {}
    if state.autoSaveKey then
        for _, item in ipairs(state.keys) do
            table.insert(savedKeys, {name = item.name, key = item.key})
        end
    end

    local payload = {
        keys = savedKeys,
        activeKey = state.activeKey,
        spyEnabled = state.spyEnabled,
        logExecutorCalls = state.logExecutorCalls,
        scanMode = state.scanMode,
        autoSwitchKeys = state.autoSwitchKeys,
        currentModel = state.currentModel,
        autoSaveKey = state.autoSaveKey,
        autoSaveConfig = state.autoSaveConfig,
        codeMode = state.codeMode,
        agentMode = state.agentMode,
        maxAgentSteps = state.maxAgentSteps,
        showActivity = state.showActivity,
        permissions = state.permissions,
        brain = state.brain
    }

    return safeWriteFile(CONFIG_FILE, HttpService:JSONEncode(payload))
end

--------------------------------------------------
-- REMOTE SPY ENGINE
--------------------------------------------------
-- Hook logic is ported from SimpleSpy: __namecall hook + FireServer /
-- InvokeServer function hooks, cloneref, checkcaller filtering, GetDebugId
-- through a BindableFunction bridge, and deferred processing so the hook
-- itself stays tiny. SimpleSpy's UI and its HttpGet dependencies are NOT
-- used. The spy only LOGS; it never blocks, edits or fires remotes.

local Spy = {
    enabled = false,
    dead = false,
    hookedNamecall = false,
    hookedFireServer = false,
    hookedInvokeServer = false,
    hookedUnreliableFireServer = false,
    notes = {},
    lastError = nil,
    totalOutgoing = 0,
    totalIncoming = 0,
    dropped = 0,
    logs = {},
    nextId = 1,
    stats = {},
    incomingAttached = 0,
    startedAt = os.clock()
}

do
    local MAX_LOGS = 10000
    local MAX_QUEUE = 6000
    local KEEP_ARGS = 400
    local MAX_DEPTH = 8
    local MAX_NODES = 2500
    local MAX_ARGS_CODE = 8000

    local hookmetamethodFn = hookmetamethod or getFileAPI("hookmetamethod")
    local hookfunctionFn = hookfunction or getFileAPI("hookfunction")
    local getrawmetatableFn = getrawmetatable or getFileAPI("getrawmetatable")
    local newcclosureFn = newcclosure or getFileAPI("newcclosure") or function(f) return f end
    local clonerefFn = cloneref or getFileAPI("cloneref") or function(x) return x end
    local checkcallerFn = checkcaller or getFileAPI("checkcaller")
    local getnamecallmethodFn = getnamecallmethod or getFileAPI("getnamecallmethod")
    local setnamecallmethodFn = setnamecallmethod or getFileAPI("setnamecallmethod")
    local getcallingscriptFn = getcallingscript or getFileAPI("getcallingscript")
    local getnilinstancesFn = getnilinstances or getFileAPI("getnilinstances")
    local getgenvFn = getgenv or getFileAPI("getgenv")
    local debugInfo = debug and debug.info
    local IsA = game.IsA

    ----------------------------------------------
    -- debug ids (bridge avoids identity problems inside hooks)
    ----------------------------------------------
    local oldGetDebugId = game.GetDebugId
    local debugIdBridge = Instance.new("BindableFunction")
    debugIdBridge.OnInvoke = function(obj)
        return oldGetDebugId(obj)
    end
    local bridgeInvoke = debugIdBridge.Invoke

    local function getDebugId(obj)
        local ok, id = pcall(bridgeInvoke, debugIdBridge, obj)
        if ok and type(id) == "string" then return id end
        return nil
    end

    ----------------------------------------------
    -- value -> Luau source serializer
    ----------------------------------------------
    local KEYWORDS = {}
    for word in ("and break do else elseif end false for function if in local nil not or repeat return then true until while"):gmatch("%S+") do
        KEYWORDS[word] = true
    end

    local function isIdentifier(name)
        return type(name) == "string" and name:match("^[%a_][%w_]*$") ~= nil and not KEYWORDS[name]
    end

    local function quote(str)
        local truncated = ""
        if #str > 2000 then
            truncated = " --[[+" .. tostring(#str - 2000) .. " more chars]]"
            str = str:sub(1, 2000)
        end
        str = str:gsub("[%c\\\"]", function(ch)
            if ch == "\n" then return "\\n" end
            if ch == "\r" then return "\\r" end
            if ch == "\t" then return "\\t" end
            if ch == "\\" then return "\\\\" end
            if ch == "\"" then return "\\\"" end
            return string.format("\\%03d", string.byte(ch))
        end)
        return '"' .. str .. '"' .. truncated
    end

    local function num(n)
        if n ~= n then return "0/0" end
        if n == math.huge then return "math.huge" end
        if n == -math.huge then return "-math.huge" end
        if n == math.floor(n) and math.abs(n) < 1e15 then
            return string.format("%d", n)
        end
        return tostring(n)
    end

    local function segment(name)
        if isIdentifier(name) then return "." .. name end
        return "[" .. quote(tostring(name)) .. "]"
    end

    local function instancePathCode(inst)
        local segments = {}
        local current = inst
        local base = nil
        local localPlayer = LocalPlayer

        for _ = 1, 250 do
            if current == nil then break end
            if current == game then
                base = "game"
                break
            end

            local okParent, parent = pcall(function() return current.Parent end)
            if not okParent then break end

            if localPlayer and current == localPlayer then
                base = 'game:GetService("Players").LocalPlayer'
                break
            end

            if localPlayer and parent == localPlayer.Character and parent ~= nil then
                -- fall through; handled when we reach the character below
            end

            if localPlayer and localPlayer.Character and current == localPlayer.Character then
                base = 'game:GetService("Players").LocalPlayer.Character'
                break
            end

            if parent == game then
                local okService, service = pcall(function() return game:GetService(current.ClassName) end)
                if okService and service == current then
                    base = 'game:GetService("' .. current.ClassName .. '")'
                else
                    base = "game"
                    table.insert(segments, 1, current.Name)
                end
                break
            end

            if parent == nil then
                return "nil --[[" .. tostring(current.ClassName) .. " " .. quote(tostring(current.Name))
                    .. " is parented to nil (use getnilinstances)]]"
            end

            table.insert(segments, 1, current.Name)
            current = parent
        end

        if not base then
            return "nil --[[could not resolve instance path]]"
        end

        local parts = {base}
        for _, name in ipairs(segments) do
            table.insert(parts, segment(name))
        end
        return table.concat(parts)
    end

    local toCode

    local function tableToCode(value, ctx, depth)
        if ctx.seen[value] then return "nil --[[cyclic table]]" end
        if depth >= MAX_DEPTH then return "{} --[[max depth]]" end

        ctx.seen[value] = true
        local parts = {}
        local count = 0
        for _ in next, value do count += 1 end

        if count == #value then
            for i = 1, #value do
                parts[i] = toCode(value[i], ctx, depth + 1)
            end
        else
            local keys = {}
            for key in next, value do keys[#keys + 1] = key end
            pcall(table.sort, keys, function(a, b) return tostring(a) < tostring(b) end)
            for _, key in ipairs(keys) do
                local keyCode
                if isIdentifier(key) then
                    keyCode = key
                else
                    keyCode = "[" .. toCode(key, ctx, depth + 1) .. "]"
                end
                parts[#parts + 1] = keyCode .. " = " .. toCode(value[key], ctx, depth + 1)
            end
        end
        ctx.seen[value] = nil

        if #parts == 0 then return "{}" end

        local oneLine = "{" .. table.concat(parts, ", ") .. "}"
        if #oneLine <= 72 and not oneLine:find("\n", 1, true) then
            return oneLine
        end

        local pad = string.rep("    ", depth + 1)
        return "{\n" .. pad .. table.concat(parts, ",\n" .. pad) .. "\n" .. string.rep("    ", depth) .. "}"
    end

    local function rawToCode(value, ctx, depth)
        ctx.nodes += 1
        if ctx.nodes > MAX_NODES then return "nil --[[truncated]]" end

        local kind = typeof(value)

        if kind == "nil" then return "nil" end
        if kind == "boolean" then return tostring(value) end
        if kind == "number" then return num(value) end
        if kind == "string" then return quote(value) end
        if kind == "table" then return tableToCode(value, ctx, depth) end
        if kind == "Instance" then return instancePathCode(value) end
        if kind == "Vector3" then return "Vector3.new(" .. num(value.X) .. ", " .. num(value.Y) .. ", " .. num(value.Z) .. ")" end
        if kind == "Vector2" then return "Vector2.new(" .. num(value.X) .. ", " .. num(value.Y) .. ")" end
        if kind == "CFrame" then
            local parts = {}
            for i, component in ipairs({value:GetComponents()}) do parts[i] = num(component) end
            return "CFrame.new(" .. table.concat(parts, ", ") .. ")"
        end
        if kind == "Color3" then return "Color3.new(" .. num(value.R) .. ", " .. num(value.G) .. ", " .. num(value.B) .. ")" end
        if kind == "UDim2" then
            return "UDim2.new(" .. num(value.X.Scale) .. ", " .. num(value.X.Offset) .. ", " .. num(value.Y.Scale) .. ", " .. num(value.Y.Offset) .. ")"
        end
        if kind == "UDim" then return "UDim.new(" .. num(value.Scale) .. ", " .. num(value.Offset) .. ")" end
        if kind == "BrickColor" then return "BrickColor.new(" .. quote(value.Name) .. ")" end
        if kind == "EnumItem" or kind == "Enum" then return tostring(value) end
        if kind == "Enums" then return "Enum" end
        if kind == "NumberRange" then return "NumberRange.new(" .. num(value.Min) .. ", " .. num(value.Max) .. ")" end
        if kind == "Rect" then
            return "Rect.new(" .. num(value.Min.X) .. ", " .. num(value.Min.Y) .. ", " .. num(value.Max.X) .. ", " .. num(value.Max.Y) .. ")"
        end
        if kind == "Ray" then
            return "Ray.new(" .. rawToCode(value.Origin, ctx, depth) .. ", " .. rawToCode(value.Direction, ctx, depth) .. ")"
        end
        if kind == "TweenInfo" then
            return "TweenInfo.new(" .. num(value.Time) .. ", " .. tostring(value.EasingStyle) .. ", " .. tostring(value.EasingDirection)
                .. ", " .. num(value.RepeatCount) .. ", " .. tostring(value.Reverses) .. ", " .. num(value.DelayTime) .. ")"
        end
        if kind == "function" then
            local name = "anonymous"
            if debugInfo then
                local okInfo, fname = pcall(debugInfo, value, "n")
                if okInfo and type(fname) == "string" and fname ~= "" then name = fname end
            end
            return "function() end --[[function: " .. name .. "]]"
        end
        if kind == "buffer" then return "nil --[[buffer]]" end
        if kind == "thread" then return "nil --[[thread]]" end

        return "nil --[[" .. tostring(kind) .. ": " .. tostring(value) .. "]]"
    end

    toCode = function(value, ctx, depth)
        local ok, code = pcall(rawToCode, value, ctx, depth)
        if ok then return code end
        return "nil --[[unserializable " .. tostring(typeof(value)) .. "]]"
    end

    local function argsToCode(args, n)
        local ctx = {nodes = 0, seen = {}}
        local parts = {}
        for i = 1, n do
            parts[i] = toCode(args[i], ctx, 1)
        end

        local code
        if #parts == 0 then
            code = "{}"
        else
            local oneLine = "{" .. table.concat(parts, ", ") .. "}"
            if #oneLine <= 100 and not oneLine:find("\n", 1, true) then
                code = oneLine
            else
                code = "{\n    " .. table.concat(parts, ",\n    "):gsub("\n", "\n    ") .. "\n}"
            end
        end

        if #code > MAX_ARGS_CODE then
            code = code:sub(1, MAX_ARGS_CODE) .. "\n--[[ truncated: arguments are very large ]]"
        end
        return code
    end

    ----------------------------------------------
    -- bounded deep clone (taken inside the hook)
    ----------------------------------------------
    local function deepClone(value, seen, budget, depth)
        if typeof(value) == "Instance" then
            return clonerefFn(value)
        end

        if type(value) == "table" then
            local existing = seen[value]
            if existing then return existing end

            local copy = {}
            seen[value] = copy
            if depth >= MAX_DEPTH then return copy end

            for key, item in next, value do
                budget.n += 1
                if budget.n > MAX_NODES then break end
                copy[deepClone(key, seen, budget, depth + 1)] = deepClone(item, seen, budget, depth + 1)
            end
            return copy
        end

        if typeof(value) == "Instance" then
            return clonerefFn(value)
        end

        return value
    end

    local function cloneArgs(packed)
        local seen, budget, cloned = {}, {n = 0}, {}
        for i = 1, packed.n do
            cloned[i] = deepClone(packed[i], seen, budget, 1)
        end
        return cloned
    end

    ----------------------------------------------
    -- queue (hook -> heartbeat processing)
    ----------------------------------------------
    local queue, qHead, qTail = {}, 1, 0

    local function enqueue(entry)
        if qTail - qHead + 1 >= MAX_QUEUE then
            Spy.dropped += 1
            return
        end
        qTail += 1
        queue[qTail] = entry
    end

    function Spy.queueSize()
        return math.max(0, qTail - qHead + 1)
    end

    local function captureOutgoing(meta, method, callerFunc, callerScript, self, ...)
        if Spy.dead or not Spy.enabled then return end

        local remote = clonerefFn(self)
        if not (IsA(remote, "RemoteEvent") or IsA(remote, "RemoteFunction") or IsA(remote, "UnreliableRemoteEvent")) then
            return
        end

        if not state.logExecutorCalls and checkcallerFn and checkcallerFn() then
            return
        end

        Spy.totalOutgoing += 1

        local packed = table.pack(...)
        enqueue({
            direction = "outgoing",
            meta = meta,
            method = method,
            remote = remote,
            n = packed.n,
            args = cloneArgs(packed),
            func = callerFunc,
            script = callerScript and clonerefFn(callerScript) or nil,
            time = os.clock()
        })
    end

    ----------------------------------------------
    -- processing
    ----------------------------------------------
    local lastByRemote = {}

    local function safeFullName(inst)
        local ok, value = pcall(function() return inst:GetFullName() end)
        if ok then return value end
        local okName, name = pcall(function() return inst.Name end)
        return okName and name or "?"
    end

    local function processEntry(e)
        local remote = e.remote
        local okInfo, name, className = pcall(function() return remote.Name, remote.ClassName end)
        if not okInfo then return end

        local path = safeFullName(remote)
        local key = getDebugId(remote) or (path .. "|" .. tostring(className))
        local argsCode = argsToCode(e.args, e.n)

        -- some executors fire BOTH the namecall hook and the function hook for
        -- one call; drop the near-instant duplicate.
        local previous = lastByRemote[key]
        if previous and e.direction == "outgoing" and previous.direction == "outgoing"
            and previous.meta ~= e.meta and (e.time - previous.time) < 0.005
            and previous.argsCode == argsCode then
            return
        end

        local scriptPath, scriptName = nil, nil
        if e.script then
            scriptPath = safeFullName(e.script)
            local okScript, sName = pcall(function() return e.script.Name end)
            scriptName = okScript and sName or nil
        end

        local callerSource, callerLine, callerName = nil, nil, nil
        if e.func and debugInfo then
            local okFn, source, line, fname = pcall(debugInfo, e.func, "sln")
            if okFn then
                callerSource, callerLine = source, line
                callerName = (type(fname) == "string" and fname ~= "") and fname or nil
            end
        end

        local record = {
            id = Spy.nextId,
            time = e.time,
            direction = e.direction,
            method = e.method,
            meta = e.meta,
            remoteName = name,
            remoteClass = className,
            remotePath = path,
            remoteKey = key,
            pathCode = instancePathCode(remote),
            argCount = e.n,
            argsCode = argsCode,
            scriptPath = scriptPath,
            scriptName = scriptName,
            callerSource = callerSource,
            callerLine = callerLine,
            callerName = callerName
        }
        Spy.nextId += 1
        lastByRemote[key] = {direction = e.direction, meta = e.meta, time = e.time, argsCode = argsCode}

        local logs = Spy.logs
        logs[#logs + 1] = record
        if Spy.onRecord then pcall(Spy.onRecord, record) end

        local old = logs[#logs - KEEP_ARGS]
        if old then old.args = nil end
        record.args = nil -- argsCode is the durable representation

        if #logs > MAX_LOGS + 500 then
            Spy.logs = table.move(logs, 501, #logs, 1, {})
        end

        local st = Spy.stats[key]
        if not st then
            st = {
                key = key, name = name, className = className, path = path,
                outgoing = 0, incoming = 0, firstSeen = e.time, lastSeen = e.time,
                times = {}, callers = {}, callerCount = 0, samples = {}, lastArgsCode = ""
            }
            Spy.stats[key] = st
        end

        if e.direction == "outgoing" then st.outgoing += 1 else st.incoming += 1 end
        st.lastSeen = e.time
        st.lastArgsCode = argsCode:sub(1, 400)

        table.insert(st.times, e.time)
        if #st.times > 30 then table.remove(st.times, 1) end

        local callerKey = scriptPath or (e.direction == "incoming" and "(server)" or "(unknown caller)")
        if st.callers[callerKey] then
            st.callers[callerKey] += 1
        elseif st.callerCount < 25 then
            st.callers[callerKey] = 1
            st.callerCount += 1
        end

        if #st.samples < 6 then
            local sample = argsCode:sub(1, 300)
            local exists = false
            for _, existing in ipairs(st.samples) do
                if existing == sample then exists = true break end
            end
            if not exists then table.insert(st.samples, sample) end
        end
    end

    local function pump()
        if Spy.dead or qHead > qTail then return end

        local deadline = os.clock() + 0.004
        local handled = 0

        while qHead <= qTail do
            local entry = queue[qHead]
            queue[qHead] = nil
            qHead += 1

            local ok, err = pcall(processEntry, entry)
            if not ok then Spy.lastError = tostring(err) end

            handled += 1
            if handled % 8 == 0 and os.clock() > deadline then break end
        end

        if qHead > qTail then
            qHead, qTail = 1, 0
        end
    end

    ----------------------------------------------
    -- hooks (outgoing FireServer / InvokeServer)
    ----------------------------------------------
    local oldNamecall = nil

    local function namecallHook(self, ...)
        local method = getnamecallmethodFn()

        if Spy.enabled and (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer")
            and typeof(self) == "Instance" then
            local callerFunc = debugInfo and debugInfo(2, "f") or nil
            local callerScript = getcallingscriptFn and getcallingscriptFn() or nil
            pcall(captureOutgoing, "__namecall", method, callerFunc, callerScript, self, ...)
            if setnamecallmethodFn then setnamecallmethodFn(method) end
        end

        return oldNamecall(self, ...)
    end

    function Spy.install()
        if Spy.installed then return true end
        Spy.installed = true
        local any = false

        if getnamecallmethodFn and (hookmetamethodFn or (hookfunctionFn and getrawmetatableFn)) then
            local ok, result = pcall(function()
                if hookmetamethodFn then
                    return hookmetamethodFn(game, "__namecall", newcclosureFn(namecallHook))
                end
                return hookfunctionFn(getrawmetatableFn(game).__namecall, newcclosureFn(namecallHook))
            end)

            if ok and type(result) == "function" then
                oldNamecall = result
                Spy.hookedNamecall = true
                any = true
            else
                table.insert(Spy.notes, "namecall hook failed: " .. tostring(result))
            end
        else
            table.insert(Spy.notes, "namecall hook unavailable (needs hookmetamethod or hookfunction, plus getnamecallmethod)")
        end

        if hookfunctionFn then
            local function hookMember(className, member, flag)
                local ok, err = pcall(function()
                    local sample = Instance.new(className)
                    local original
                    original = hookfunctionFn(sample[member], newcclosureFn(function(self, ...)
                        if Spy.enabled and typeof(self) == "Instance" then
                            local callerFunc = debugInfo and debugInfo(2, "f") or nil
                            local callerScript = getcallingscriptFn and getcallingscriptFn() or nil
                            pcall(captureOutgoing, "__index", member, callerFunc, callerScript, self, ...)
                        end
                        return original(self, ...)
                    end))
                    Spy[flag] = true
                    any = true
                end)
                if not ok then
                    table.insert(Spy.notes, className .. "." .. member .. " hook failed: " .. tostring(err))
                end
            end

            hookMember("RemoteEvent", "FireServer", "hookedFireServer")
            hookMember("RemoteFunction", "InvokeServer", "hookedInvokeServer")
            pcall(hookMember, "UnreliableRemoteEvent", "FireServer", "hookedUnreliableFireServer")
        else
            table.insert(Spy.notes, "hookfunction unavailable: direct FireServer/InvokeServer function calls cannot be hooked")
        end

        if RunService then
            Spy.pumpConnection = RunService.Heartbeat:Connect(pump)
        end

        return any
    end

    ----------------------------------------------
    -- incoming (server -> client RemoteEvent.OnClientEvent)
    ----------------------------------------------
    local attached = {}

    function Spy.attachIncoming(remote)
        if Spy.dead then return false end

        local okType, isEvent = pcall(function()
            return IsA(remote, "RemoteEvent") or IsA(remote, "UnreliableRemoteEvent")
        end)
        if not okType or not isEvent then return false end

        local id = getDebugId(remote)
        local attachKey = id or remote
        if attached[attachKey] then return false end

        local ok, connection = pcall(function()
            return remote.OnClientEvent:Connect(function(...)
                if Spy.dead or not Spy.enabled then return end
                Spy.totalIncoming += 1
                local packed = table.pack(...)
                enqueue({
                    direction = "incoming",
                    meta = "OnClientEvent",
                    method = "OnClientEvent",
                    remote = remote,
                    n = packed.n,
                    args = cloneArgs(packed),
                    time = os.clock()
                })
            end)
        end)

        if ok and connection then
            attached[attachKey] = connection
            Spy.incomingAttached += 1
            return true
        end
        return false
    end

    function Spy.attachAllIncoming(progress)
        local processed, count = 0, 0
        local ok, err = pcall(function()
            for _, inst in ipairs(game:GetDescendants()) do
                processed += 1
                if Spy.attachIncoming(inst) then count += 1 end
                if processed % 1500 == 0 then
                    if progress then progress(processed) end
                    task.wait()
                end
            end
        end)
        if not ok then Spy.lastError = tostring(err) end

        if getnilinstancesFn then
            pcall(function()
                for _, inst in ipairs(getnilinstancesFn()) do
                    if Spy.attachIncoming(inst) then count += 1 end
                end
            end)
        end

        return count, processed
    end

    function Spy.watchNewRemotes()
        if Spy.descendantConnection then return end
        Spy.descendantConnection = game.DescendantAdded:Connect(function(inst)
            if Spy.dead then return end
            Spy.attachIncoming(inst)
        end)
    end

    ----------------------------------------------
    -- query API (used by the AI tools and the settings card)
    ----------------------------------------------
    local function lower(text) return string.lower(tostring(text or "")) end

    local function ago(time)
        return math.floor((os.clock() - time) * 100) / 100
    end

    function Spy.setEnabled(value)
        Spy.enabled = value == true
        state.spyEnabled = Spy.enabled
    end

    function Spy.clear()
        Spy.logs = {}
        Spy.stats = {}
        Spy.totalOutgoing = 0
        Spy.totalIncoming = 0
        Spy.dropped = 0
        queue, qHead, qTail = {}, 1, 0
        lastByRemote = {}
    end

    function Spy.status()
        local uniqueRemotes = 0
        for _ in pairs(Spy.stats) do uniqueRemotes += 1 end

        return {
            enabled = Spy.enabled,
            hookedNamecall = Spy.hookedNamecall,
            hookedFireServerFunction = Spy.hookedFireServer,
            hookedInvokeServerFunction = Spy.hookedInvokeServer,
            hookedUnreliableFireServerFunction = Spy.hookedUnreliableFireServer,
            outgoingCallsSeen = Spy.totalOutgoing,
            incomingEventsSeen = Spy.totalIncoming,
            droppedWhileBusy = Spy.dropped,
            queued = Spy.queueSize(),
            callsStored = #Spy.logs,
            uniqueRemotesSeen = uniqueRemotes,
            incomingRemotesObserved = Spy.incomingAttached,
            logExecutorCalls = state.logExecutorCalls,
            notes = Spy.notes,
            lastError = Spy.lastError
        }
    end

    local function matches(record, remoteFilter, queryFilter)
        if remoteFilter ~= "" then
            local hay = lower(record.remotePath)
            if not string.find(hay, remoteFilter, 1, true) then return false end
        end
        if queryFilter ~= "" then
            local hay = lower(record.remotePath .. " " .. tostring(record.scriptPath or "") .. " " .. record.argsCode)
            if not string.find(hay, queryFilter, 1, true) then return false end
        end
        return true
    end

    function Spy.recent(options)
        options = options or {}
        local direction = lower(options.direction ~= nil and options.direction or "both")
        local remoteFilter = lower(options.remote or "")
        local queryFilter = lower(options.query or "")
        local afterId = tonumber(options.after_id) or 0
        local limit = math.clamp(math.floor(tonumber(options.limit) or 60), 1, 500)
        local maxChars = math.clamp(math.floor(tonumber(options.max_arg_chars) or 700), 80, 6000)
        local oldestFirst = options.oldest_first == true

        local picked = {}
        local logs = Spy.logs
        for i = #logs, 1, -1 do
            local record = logs[i]
            if record.id <= afterId then break end
            if (direction == "both" or record.direction == direction)
                and matches(record, remoteFilter, queryFilter) then
                table.insert(picked, record)
                if #picked >= limit then break end
            end
        end

        if oldestFirst then
            local reversed = {}
            for i = #picked, 1, -1 do table.insert(reversed, picked[i]) end
            picked = reversed
        end

        local out = {}
        for _, record in ipairs(picked) do
            local args = record.argsCode
            if #args > maxChars then
                args = args:sub(1, maxChars) .. " --[[cut: use get_remote_call id=" .. record.id .. " for full args]]"
            end
            table.insert(out, {
                id = record.id,
                secondsAgo = ago(record.time),
                direction = record.direction,
                remote = record.remotePath,
                class = record.remoteClass,
                method = record.method,
                argCount = record.argCount,
                args = args,
                callingScript = record.scriptPath
            })
        end
        return out
    end

    function Spy.summary(options)
        options = options or {}
        local remoteFilter = lower(options.remote or options.query or "")
        local limit = math.clamp(math.floor(tonumber(options.limit) or 120), 1, 1000)
        local list = {}

        for _, st in pairs(Spy.stats) do
            if remoteFilter == "" or string.find(lower(st.path), remoteFilter, 1, true) then
                local rate = nil
                local count = #st.times
                if count >= 2 then
                    local span = st.times[count] - st.times[1]
                    if span > 0 then rate = math.floor(((count - 1) / span) * 10) / 10 end
                end

                local callerList = {}
                for callerPath, hits in pairs(st.callers) do
                    table.insert(callerList, {script = callerPath, calls = hits})
                end
                table.sort(callerList, function(a, b) return a.calls > b.calls end)
                while #callerList > 4 do table.remove(callerList) end

                table.insert(list, {
                    remote = st.path,
                    class = st.className,
                    outgoingCalls = st.outgoing,
                    incomingEvents = st.incoming,
                    callsPerSecondRecently = rate,
                    secondsSinceLast = ago(st.lastSeen),
                    topCallers = callerList,
                    sampleArgs = st.samples
                })
            end
        end

        table.sort(list, function(a, b)
            local totalA, totalB = a.outgoingCalls + a.incomingEvents, b.outgoingCalls + b.incomingEvents
            if totalA == totalB then return a.remote < b.remote end
            return totalA > totalB
        end)

        local total = #list
        while #list > limit do table.remove(list) end
        return list, total
    end

    function Spy.getCall(id)
        id = tonumber(id)
        if not id then return nil, "id is required" end

        local logs = Spy.logs
        local first = logs[1]
        if not first then return nil, "no calls have been logged yet" end

        local record = logs[id - first.id + 1]
        if not record or record.id ~= id then
            return nil, "that call is no longer stored (log keeps the newest " .. tostring(MAX_LOGS) .. ")"
        end

        local replay
        if record.direction == "outgoing" then
            local call = (record.remoteClass == "RemoteFunction") and ":InvokeServer(" or ":FireServer("
            replay = "local args = " .. record.argsCode .. "\n" .. record.pathCode .. call .. "unpack(args, 1, " .. tostring(record.argCount) .. "))"
        else
            replay = "-- incoming server -> client event; args as received:\nlocal args = " .. record.argsCode
        end

        return {
            id = record.id,
            secondsAgo = ago(record.time),
            direction = record.direction,
            remote = record.remotePath,
            remoteAccessCode = record.pathCode,
            class = record.remoteClass,
            method = record.method,
            hookedVia = record.meta,
            argCount = record.argCount,
            argsAsLuau = record.argsCode,
            replayScript = replay,
            callingScript = record.scriptPath,
            callerFunction = {
                name = record.callerName,
                source = record.callerSource,
                line = record.callerLine
            }
        }
    end

    ----------------------------------------------
    -- lifecycle (re-execution safe)
    ----------------------------------------------
    function Spy.shutdown()
        Spy.dead = true
        Spy.enabled = false
        if Spy.pumpConnection then pcall(function() Spy.pumpConnection:Disconnect() end) end
        if Spy.descendantConnection then pcall(function() Spy.descendantConnection:Disconnect() end) end
        for _, connection in pairs(attached) do
            pcall(function() connection:Disconnect() end)
        end
    end

    pcall(function()
        local genv = getgenvFn and getgenvFn() or nil
        if genv then
            if type(genv.SimpleXVibeSpyShutdown) == "function" then
                pcall(genv.SimpleXVibeSpyShutdown)
            end
            genv.SimpleXVibeSpyShutdown = Spy.shutdown
        end
    end)
end

