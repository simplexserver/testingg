local escapeRich, markdownToRich, splitFences
do
--------------------------------------------------
-- MARKDOWN -> ROBLOX RICH TEXT
--------------------------------------------------

function escapeRich(text)
    text = tostring(text or "")
    text = text:gsub("&", "&amp;")
    text = text:gsub("<", "&lt;")
    text = text:gsub(">", "&gt;")
    return text
end

local function applyInlineMarkdown(part)
    -- bold
    part = part:gsub("%*%*(.-)%*%*", "<b>%1</b>")
    part = part:gsub("__(.-)__", "<b>%1</b>")
    -- italic (needs non-space next to the markers so "2 * 3 * 4" is left alone)
    part = part:gsub("%*([^%s%*][^%*]-[^%s%*])%*", "<i>%1</i>")
    part = part:gsub("%*([^%s%*])%*", "<i>%1</i>")
    -- strikethrough
    part = part:gsub("~~(.-)~~", "<s>%1</s>")
    -- links
    part = part:gsub("%[([^%]]+)%]%(([^%)]+)%)", '<u>%1</u> <font color="#8a8a95">(%2)</font>')
    return part
end

local function inlineMarkdown(line)
    local out = {}
    local inCode = false
    for piece in (line .. "`"):gmatch("(.-)`") do
        if inCode then
            table.insert(out, '<font color="#8fd0ff">' .. piece .. "</font>")
        else
            table.insert(out, applyInlineMarkdown(piece))
        end
        inCode = not inCode
    end
    return table.concat(out)
end

function markdownToRich(text)
    text = tostring(text or ""):gsub("\r", "")
    local lines = {}

    for rawLine in (text .. "\n"):gmatch("(.-)\n") do
        local line = escapeRich(rawLine)
        local heading = line:match("^%s*#+%s+(.+)$")
        local hashes = line:match("^%s*(#+)%s+")
        local bullet = line:match("^(%s*)[%-%*%+]%s+")
        local numbered = line:match("^(%s*)%d+[%.%)]%s+")
        local quote = line:match("^%s*&gt;%s?(.*)$")

        if heading then
            local size = (#hashes <= 1) and 16 or ((#hashes == 2) and 15 or 14)
            table.insert(lines, '<font size="' .. size .. '"><b>' .. inlineMarkdown(heading) .. "</b></font>")
        elseif line:match("^%s*%-%-%-+%s*$") or line:match("^%s*%*%*%*+%s*$") then
            table.insert(lines, '<font color="#4a4a52">────────────────────</font>')
        elseif line:match("^%s*|.*|%s*$") then
            if not line:match("^[%s|:%-]+$") then
                local row = line:gsub("^%s*|", ""):gsub("|%s*$", "")
                row = row:gsub("|", '  <font color="#55555d">│</font>  ')
                table.insert(lines, inlineMarkdown(row))
            end
        elseif bullet then
            local body = line:gsub("^%s*[%-%*%+]%s+", "")
            table.insert(lines, bullet .. "•  " .. inlineMarkdown(body))
        elseif numbered then
            local number, body = line:match("^%s*(%d+)[%.%)]%s+(.*)$")
            table.insert(lines, numbered .. "<b>" .. tostring(number) .. ".</b>  " .. inlineMarkdown(body or ""))
        elseif quote then
            table.insert(lines, '<font color="#9a9aa5">▎ ' .. inlineMarkdown(quote) .. "</font>")
        else
            table.insert(lines, inlineMarkdown(line))
        end
    end

    -- collapse 3+ blank lines to a single blank line, trim ends
    local joined = table.concat(lines, "\n")
    joined = joined:gsub("\n\n\n+", "\n\n")
    joined = joined:gsub("^%s+", ""):gsub("%s+$", "")
    return joined
end

-- Split an AI answer into text and ``` fenced code segments.
function splitFences(text)
    text = tostring(text or "")
    local segments = {}
    local pos = 1

    while true do
        local fenceStart, fenceEnd = text:find("```", pos, true)
        if not fenceStart then break end

        if fenceStart > pos then
            table.insert(segments, {kind = "text", body = text:sub(pos, fenceStart - 1)})
        end

        local newline = text:find("\n", fenceEnd + 1, true)
        local close = text:find("```", fenceEnd + 1, true)
        local lang, bodyStart = "", fenceEnd + 1

        if newline and (not close or newline < close) then
            lang = text:sub(fenceEnd + 1, newline - 1):gsub("%s+", "")
            bodyStart = newline + 1
        end

        local code
        if close and close >= bodyStart then
            code = text:sub(bodyStart, close - 1)
            pos = close + 3
        elseif close then
            code = ""
            pos = close + 3
        else
            code = text:sub(bodyStart)
            pos = #text + 1
        end

        code = code:gsub("\n$", "")
        table.insert(segments, {kind = "code", body = code, lang = lang})
    end

    if pos <= #text then
        table.insert(segments, {kind = "text", body = text:sub(pos)})
    end

    return segments
end

end

